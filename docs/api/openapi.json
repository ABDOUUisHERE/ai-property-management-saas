{
  "components": {
    "schemas": {
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CsrfResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "minimum": 0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "examples": [
              "MAD"
            ],
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "Pagination": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 25,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          }
        },
        "title": "Pagination",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Registration",
        "type": "object"
      },
      "RegistrationAccepted": {
        "properties": {
          "status": {
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "RegistrationAccepted",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileResponse"
          }
        },
        "required": [
          "profile",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StayDates": {
        "additionalProperties": false,
        "properties": {
          "check_in": {
            "format": "date",
            "title": "Check In",
            "type": "string"
          },
          "check_out": {
            "format": "date",
            "title": "Check Out",
            "type": "string"
          }
        },
        "required": [
          "check_in",
          "check_out"
        ],
        "title": "StayDates",
        "type": "object"
      },
      "Timestamp": {
        "additionalProperties": false,
        "properties": {
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          }
        },
        "required": [
          "occurred_at"
        ],
        "title": "Timestamp",
        "type": "object"
      }
    },
    "securitySchemes": {
      "LocalSession": {
        "description": "Explicit local HTTP profile only",
        "in": "cookie",
        "name": "pms_session",
        "type": "apiKey"
      },
      "SecureSession": {
        "description": "HTTPS HttpOnly cookie",
        "in": "cookie",
        "name": "__Host-pms_session",
        "type": "apiKey"
      }
    }
  },
